    "data:clean": "node scripts/clean_incidents.mjs",
    "data:forecast": "node scripts/build_forecast.mjs",
    "data:all": "npm run data:excel && npm run data:forecast"
  },
  "dependencies": {
    "@svg-maps/taiwan": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
