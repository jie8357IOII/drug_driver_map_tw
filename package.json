{
  "name": "taiwan-drug-driving-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:excel": "python3 scripts/convert_excel.py public/data/q04010103_210702733.xlsx public/data/drug_suspects_monthly.json",
